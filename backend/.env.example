# ── Copy to backend/.env and fill in real values. NEVER commit .env ──────────

# Supabase PostgreSQL connection string (session/transaction pooler is fine).
# Format: postgresql://<user>:<password>@<host>:5432/postgres
DATABASE_URL=postgresql://postgres:REPLACE_ME@db.example.supabase.co:5432/postgres

# Supabase project URL, used to derive the JWT issuer and JWKS URL.
SUPABASE_URL=https://example.supabase.co

# Legacy HS256 secret. Leave BLANK if the project uses asymmetric signing keys.
SUPABASE_JWT_SECRET=

# Asymmetric verification (recommended for new Supabase projects).
# Leave BLANK to derive <SUPABASE_URL>/auth/v1/.well-known/jwks.json automatically.
SUPABASE_JWKS_URL=

# Usually <SUPABASE_URL>/auth/v1. Override if your project differs.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Supabase's sb_secret_... API key is NOT used by this Python backend and must
# never be placed in frontend/.env* or committed. Django verifies JWTs with JWKS.

# Comma-separated allowed frontend origins, e.g. http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local isolated test cluster used by the test harness (Phase 2+).
# Not needed in production.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/postgres
