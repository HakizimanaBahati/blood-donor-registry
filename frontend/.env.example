# ── Copy to frontend/.env.local and fill in real values. NEVER commit it ─────

# Public Supabase project settings (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# Django REST API base URL. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Development-only demo login backed by POST /api/auth/dev-login/.
# Leave this unset (or false) in any deployed environment.
NEXT_PUBLIC_ALLOW_DEV_LOGIN=true

# NEVER put a Supabase service-role key, JWT secret, or database URL here.
